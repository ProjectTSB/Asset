#> asset:object/1219.font_animation/register
#
# Objectのデータを指定
#
# @within function asset:object/alias/1219/register

# IDと型
    data modify storage asset:object ID set value 1219
    data modify storage asset:object IsAbstract set value false

# 召喚時の表示倍率（正の数値）
    data modify storage asset:object Field.Scale set value 1f
